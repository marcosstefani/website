extends layout

block seo
    meta(name="description" content="Sucuri — Template engine para Python inspirado no PugJS. Sintaxe elegante baseada em indentação, sem dependência de frameworks.")
    meta(property="og:title" content="Sucuri — Template Engine para Python")

block content
    section(class="max-w-5xl mx-auto px-6 py-24 border-b border-zinc-800/50")
        div(class="flex flex-col lg:flex-row gap-12 items-start")
            div(class="flex-1 min-w-0")
                span(class="inline-block mb-4 px-3 py-1 bg-violet-500/15 text-violet-400 text-xs font-semibold rounded-full tracking-widest uppercase border border-violet-500/25") Template Engine para Python
                h1(class="text-5xl font-bold text-white leading-tight font-display") Sucuri
                p(class="mt-4 text-zinc-400 text-lg leading-relaxed max-w-xl") Uma engine de templates elegante para Python inspirada no PugJS. Sintaxe baseada em indentação, sem dependência de framework — funciona com FastAPI, Flask, Django ou Python puro.
                ul(class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-lg" style="list-style:none;padding:0;margin-top:2rem;")
                    li(class="flex items-start gap-3")
                        span(class="text-violet-400 font-bold") ✦
                        span(class="text-zinc-300 text-sm") Sintaxe limpa baseada em indentação
                    li(class="flex items-start gap-3")
                        span(class="text-violet-400 font-bold") ✦
                        span(class="text-zinc-300 text-sm") Loops, condicionais e variáveis
                    li(class="flex items-start gap-3")
                        span(class="text-violet-400 font-bold") ✦
                        span(class="text-zinc-300 text-sm") Macros para listas e tabelas
                    li(class="flex items-start gap-3")
                        span(class="text-violet-400 font-bold") ✦
                        span(class="text-zinc-300 text-sm") Servidor live com hot reload
                    li(class="flex items-start gap-3")
                        span(class="text-violet-400 font-bold") ✦
                        span(class="text-zinc-300 text-sm") Proteção XSS por padrão
                    li(class="flex items-start gap-3")
                        span(class="text-violet-400 font-bold") ✦
                        span(class="text-zinc-300 text-sm") Herança de templates (extends/block)
                div(class="mt-10 flex flex-wrap gap-4")
                    a(href="https://github.com/marcosstefani/sucuri" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-100 text-zinc-900 text-sm font-bold rounded-xl hover:bg-white transition-colors") ↗ GitHub
                    a(href="#" class="inline-flex items-center gap-2 px-6 py-3 bg-violet-600/20 text-violet-400/60 text-sm font-bold rounded-xl border border-violet-500/20 cursor-not-allowed select-none") ▶ Curso Udemy (em breve)
            div(class="hidden lg:flex flex-col gap-4 flex-shrink-0 w-72")
                div(class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5")
                    p(class="text-zinc-500 text-xs font-semibold uppercase tracking-widest mb-3") Instalação
                    div(class="flex items-center justify-between bg-zinc-950 rounded-xl px-4 py-3")
                        span(class="font-mono text-sm text-violet-400") pip install sucuri
                        button(id="copy-install" class="text-zinc-600 hover:text-zinc-300 text-xs transition-colors ml-3") copiar
                div(class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5")
                    p(class="text-zinc-500 text-xs font-semibold uppercase tracking-widest mb-3") Compatível com
                    div(class="flex flex-wrap gap-2")
                        span(class="px-2 py-1 bg-zinc-800 text-zinc-300 text-xs rounded-lg") FastAPI
                        span(class="px-2 py-1 bg-zinc-800 text-zinc-300 text-xs rounded-lg") Flask
                        span(class="px-2 py-1 bg-zinc-800 text-zinc-300 text-xs rounded-lg") Django
                        span(class="px-2 py-1 bg-zinc-800 text-zinc-300 text-xs rounded-lg") Python puro

    section(class="max-w-6xl mx-auto px-6 py-20")
        div(class="mb-10")
            span(class="text-violet-400 font-display text-sm font-semibold tracking-widest uppercase") Playground
            h2(class="mt-2 text-3xl font-bold text-white font-display") Experimente
            p(class="mt-3 text-zinc-400 max-w-2xl") Edite o template Sucuri e o contexto Python. Clique em Executar para renderizar o resultado.
        div(id="example-tabs" class="flex gap-2 flex-wrap mb-6")
        div(class="border border-zinc-800 rounded-2xl overflow-hidden")
            div(class="grid lg:grid-cols-2" style="min-height:520px;")
                div(class="flex flex-col border-b lg:border-b-0 lg:border-r border-zinc-800")
                    div(class="flex items-center gap-2 px-4 py-3 bg-zinc-900/80 border-b border-zinc-800 flex-shrink-0")
                        div(class="w-3 h-3 rounded-full bg-red-500/60")
                        div(class="w-3 h-3 rounded-full bg-yellow-500/60")
                        div(class="w-3 h-3 rounded-full bg-green-500/60")
                        span(class="ml-2 text-zinc-500 text-xs font-mono") template.suc
                    textarea(id="suc-code" spellcheck="false" class="flex-1 bg-zinc-950 text-zinc-100 font-mono text-sm px-5 py-4 resize-none focus:outline-none leading-relaxed" style="min-height:260px;")
                    div(class="flex-shrink-0 border-t border-zinc-800")
                        div(class="px-4 py-2 bg-zinc-900/50 border-b border-zinc-800")
                            span(class="text-zinc-500 text-xs font-mono") context.json
                        textarea(id="suc-context" spellcheck="false" class="w-full bg-zinc-950 text-emerald-400 font-mono text-xs px-5 py-3 resize-none focus:outline-none" style="height:120px;")
                    div(class="flex items-center justify-end px-4 py-3 bg-zinc-900/50 border-t border-zinc-800 flex-shrink-0")
                        button(id="run-btn" class="flex items-center gap-2 px-5 py-2 bg-violet-600 hover:bg-violet-500 text-white text-sm font-semibold rounded-xl transition-colors") ▶ Executar
                div(class="flex flex-col bg-zinc-950")
                    div(class="flex items-center justify-between px-4 py-3 bg-zinc-900/80 border-b border-zinc-800 flex-shrink-0")
                        span(class="text-zinc-500 text-xs font-mono") preview
                        div(class="flex gap-1")
                            button(id="view-preview" class="px-3 py-1 text-xs rounded-lg bg-violet-600 text-white font-medium") Preview
                            button(id="view-html" class="px-3 py-1 text-xs rounded-lg text-zinc-400 hover:text-white transition-colors") HTML
                    iframe(id="preview-frame" class="w-full border-0 bg-white flex-1" style="min-height:380px;")
                    pre(id="html-output" class="hidden w-full overflow-auto text-xs font-mono text-zinc-300 px-5 py-4 leading-relaxed m-0 flex-1" style="min-height:380px;")
                    div(id="error-msg" class="hidden px-4 py-3 bg-red-950/40 border-t border-red-900/40 text-red-400 text-xs font-mono flex-shrink-0")
    | <script src="/static/js/playground.js"></script>
