details(class="relative group")
    summary(class="list-none cursor-pointer hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-400 rounded-sm transition-colors inline-flex items-center gap-1")
        | Dev
        span(class="text-[10px] text-zinc-500 group-hover:text-zinc-300 transition-colors" aria-hidden="true") ▾
    div(class="absolute top-full left-0 pt-3 z-10")
        div(class="min-w-44 bg-zinc-900 border border-zinc-800 rounded-xl shadow-2xl p-2")
            a(href="/sucuri" class="block px-3 py-2 rounded-lg text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors") sucuri
            a(href="/sqla-lite" class="block px-3 py-2 rounded-lg text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors") sqla-lite
