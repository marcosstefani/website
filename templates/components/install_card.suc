div(class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5")
    p(class="text-zinc-500 text-xs font-semibold uppercase tracking-widest mb-3") Instalação
    div(class="flex items-center justify-between bg-zinc-950 rounded-xl px-4 py-3")
        span(class="font-mono text-sm text-violet-400 whitespace-nowrap") {install_command}
        button(id="copy-install" class="text-zinc-600 hover:text-zinc-300 text-xs transition-colors ml-3 shrink-0") copiar
